// Pandoc template (Typst) for the project's technical documentation.
// Used by build.sh: pandoc <file>.md --pdf-engine=typst --template=template/report.typst
// Metadata comes from the YAML block at the top of the Markdown file.

#let horizontalRule = line(length: 100%, stroke: 0.5pt + luma(180))
#let divider = horizontalRule

$if(highlighting-definitions)$
$highlighting-definitions$
$endif$

// --- Colours and fonts -------------------------------------------------------
#let accent = rgb("#1f4e79")
#let muted = luma(110)
#let body-font = ("Charter", "Libertinus Serif")
#let heading-font = ("Helvetica Neue", "Avenir Next", "New Computer Modern")
#let code-font = ("Menlo", "DejaVu Sans Mono")

#let doc-title = [$if(title)$$title$$endif$]

#set document(title: doc-title$if(author)$, author: ($for(author)$"$author$"$sep$, $endfor$)$endif$)
#set text(font: body-font, size: 10.5pt, lang: "en")
#set par(justify: true, leading: 0.7em, spacing: 1.1em)

// --- Title page --------------------------------------------------------------
#page(paper: "a4", margin: (x: 2.5cm, y: 3cm), numbering: none)[
  #set par(justify: false)
  #v(2cm)
  $if(institution)$#text(font: heading-font, size: 11pt, fill: muted)[$institution$]$endif$
  $if(course)$\ #text(font: heading-font, size: 11pt, fill: muted)[$course$]$endif$
  #v(1fr)
  #line(length: 100%, stroke: 2pt + accent)
  #v(0.6cm)
  #text(font: heading-font, size: 26pt, weight: "bold", fill: accent)[#doc-title]
  $if(subtitle)$
  #v(0.3cm)
  #text(font: heading-font, size: 15pt, fill: luma(60))[$subtitle$]
  $endif$
  #v(0.6cm)
  #line(length: 100%, stroke: 0.5pt + accent)
  #v(1fr)
  #grid(
    columns: (auto, 1fr),
    column-gutter: 1.2em,
    row-gutter: 0.8em,
    $if(author)$text(font: heading-font, weight: "bold")[Team], [$for(author)$$author$$sep$ \ $endfor$],$endif$
    $if(version)$text(font: heading-font, weight: "bold")[Version], [$version$],$endif$
    $if(repository)$text(font: heading-font, weight: "bold")[Repository], [#link("$repository$")[$repository$]],$endif$
    $if(date)$text(font: heading-font, weight: "bold")[Date], [$date$],$endif$
  )
  #v(1.5cm)
]

// --- Page layout for the rest of the document --------------------------------
#set page(
  paper: "a4",
  margin: (x: 2.5cm, top: 2.8cm, bottom: 2.5cm),
  header: context {
    set text(font: heading-font, size: 8.5pt, fill: muted)
    grid(columns: (1fr, auto), doc-title, [$if(subtitle)$$subtitle$$endif$])
    v(-0.5em)
    line(length: 100%, stroke: 0.4pt + luma(200))
  },
  footer: context {
    set text(font: heading-font, size: 8.5pt, fill: muted)
    align(right)[#counter(page).display("1") / #counter(page).final().first()]
  },
)
#counter(page).update(1)

// --- Headings ----------------------------------------------------------------
#set heading(numbering: "1.1")
#show heading: set text(font: heading-font, fill: accent)
#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  v(0.4cm)
  text(size: 18pt, weight: "bold", it)
  v(0.3cm)
}
#show heading.where(level: 2): it => { v(0.4cm); text(size: 13pt, weight: "bold", it); v(0.15cm) }
#show heading.where(level: 3): it => { v(0.2cm); text(size: 11pt, weight: "bold", it) }

// --- Links, code, tables, figures --------------------------------------------
#show link: set text(fill: accent)
#show raw: set text(font: code-font, size: 8.8pt)
#show raw.where(block: false): box.with(fill: luma(242), inset: (x: 3pt, y: 0pt), outset: (y: 3pt), radius: 2pt)
#show raw.where(block: true): block.with(fill: luma(246), inset: 10pt, radius: 3pt, width: 100%, stroke: 0.5pt + luma(225))

#set table(
  inset: (x: 7pt, y: 5pt),
  stroke: (x, y) => (bottom: 0.4pt + luma(210), top: if y == 0 { 1pt + accent } else { none }),
  fill: (x, y) => if y == 0 { accent.lighten(88%) } else if calc.even(y) { luma(250) } else { none },
)
#show table.cell.where(y: 0): set text(font: heading-font, weight: "bold", size: 9.5pt)
#show table: set text(size: 9.5pt)
#show table: set par(justify: false)
// Cells start left-aligned; the table itself stays centred on the page.
#show table: it => { set align(left); it }
#show figure: set block(spacing: 1.4em)
#show figure.caption: set text(size: 9pt, fill: muted)
#show figure.where(kind: table): set figure.caption(position: top)

#set list(indent: 0.6em)
#set enum(indent: 0.6em)
#show quote.where(block: true): block.with(stroke: (left: 2pt + accent), inset: (left: 10pt, y: 4pt))

// --- Table of contents ---------------------------------------------------------
$if(toc)$
#[
  #show outline.entry.where(level: 1): set text(font: heading-font, weight: "bold")
  #outline(title: [Contents], depth: $if(toc-depth)$$toc-depth$$else$2$endif$, indent: auto)
]
#pagebreak()
$endif$

$body$
